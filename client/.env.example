# URL бекенду для production-збірки (Vercel → Settings → Environment Variables)
# Приклад: https://your-backend.example.com
REACT_APP_SERVER_URL=

# Локально proxy з package.json веде на http://localhost:3200
# REACT_APP_SERVER_URL потрібен лише для production build на Vercel

REACT_APP_GOOGLE_MAPS_API_KEY=
