generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  uuid           String           @id @default(uuid()) @db.Uuid
  title          String           @db.VarChar(128)
  image_url      String           @db.VarChar(255)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  sub_categories sub_categories[]
}

model cities {
  uuid        String        @id(map: "city_pkey") @default(uuid()) @db.Uuid
  name        String        @db.VarChar(128)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  longitude   Decimal?      @db.Decimal(11, 8)
  latitude    Decimal?      @db.Decimal(10, 8)
  restaurants restaurants[]
  users       users[]
}

model dish_comments {
  uuid       String   @id @default(uuid()) @db.Uuid
  dish_uuid  String   @db.Uuid
  user_uuid  String   @db.Uuid
  comment    String?
  rating     Int      @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  dishes     dishes   @relation(fields: [dish_uuid], references: [uuid], onDelete: Cascade, map: "fk_dishuuid_dishcomments")
  users      users    @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, map: "fk_useruuid_dishcomments")
}

model dish_images {
  uuid       String   @id @default(uuid()) @db.Uuid
  title      String   @db.VarChar(128)
  image_url  String   @db.VarChar(255)
  dish_uuid  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  dishes     dishes   @relation(fields: [dish_uuid], references: [uuid], onDelete: Cascade, map: "fk_dishimages_dishes")
}

model dishes {
  uuid               String          @id @default(uuid()) @db.Uuid
  name               String          @db.VarChar(255)
  weight             Int
  price              Int
  frozen             Boolean         @default(false)
  spicy              Boolean         @default(false)
  ingredients        String
  sub_category_uuid  String          @db.Uuid
  active             Boolean         @default(false)
  corporate_type     String?         @db.VarChar(64)
  wholesale_min_qty  Int?
  wholesale_price    Int?
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  dish_comments      dish_comments[]
  dish_images        dish_images[]
  sub_categories     sub_categories  @relation(fields: [sub_category_uuid], references: [uuid], onDelete: Cascade, map: "fk_dishes_subcategory")
  favorites          favorites[]
  order_dish         order_dish[]

  @@index([sub_category_uuid], map: "fk_dishes_subcategories")
}

model favorites {
  user_uuid  String   @db.Uuid
  dish_uuid  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  dishes     dishes   @relation(fields: [dish_uuid], references: [uuid], onDelete: Cascade, map: "fk_favorites_dishes")
  users      users    @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, map: "fk_favorites_users")

  @@id([user_uuid, dish_uuid], map: "pk_favorites")
}

model order_dish {
  uuid       String @id @default(uuid()) @db.Uuid
  order_uuid String @db.Uuid
  dish_uuid  String @db.Uuid
  count      Int
  dishes     dishes @relation(fields: [dish_uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction, map: "fk_dishes_orderdish")
  orders     orders @relation(fields: [order_uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_orderdish")
}

model orders {
  uuid             String       @id @default(uuid()) @db.Uuid
  user_uuid        String       @db.Uuid
  status           String       @default("processing")
  delivery_address String       @db.VarChar(255)
  payment_method   String
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  total_price      Int
  order_dish       order_dish[]
  users            users        @relation(fields: [user_uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_orders")
}

model partners {
  uuid         String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  logo_img     String   @db.VarChar(255)
  link_website String?  @db.VarChar(255)
  active       Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
}

model restaurants {
  uuid             String   @id @default(uuid()) @db.Uuid
  city_uuid        String   @db.Uuid
  name             String   @db.VarChar(128)
  description      String   @db.VarChar(255)
  address          String   @db.VarChar(255)
  phone            String   @db.VarChar(64)
  latitude         Decimal  @db.Decimal(10, 8)
  longitude        Decimal  @db.Decimal(11, 8)
  active           Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  time_work        String
  restaurant_image String
  cities           cities   @relation(fields: [city_uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction, map: "restaurant_city")
}

model sale {
  uuid       String   @id @default(uuid()) @db.Uuid
  active     Boolean  @default(false)
  title      String   @db.VarChar(128)
  image_url  String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model sub_categories {
  uuid          String     @id(map: "subcategories_pkey") @default(uuid()) @db.Uuid
  name          String     @db.VarChar(128)
  category_uuid String     @db.Uuid
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  dishes        dishes[]
  categories    categories @relation(fields: [category_uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction, map: "fk_subcategories_categories")
}

model users {
  uuid          String          @id @default(uuid()) @db.Uuid
  email         String          @db.VarChar(128)
  name          String          @db.VarChar(64)
  surname       String          @db.VarChar(64)
  password      String          @db.VarChar(255)
  phone         String          @db.VarChar(64)
  role          String          @default("user")
  company_name  String?         @db.VarChar(255)
  company_type  String?         @db.VarChar(255)
  city_uuid     String?         @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  bonuses       Int             @default(0)
  cities        cities?         @relation(fields: [city_uuid], references: [uuid], onDelete: SetNull, onUpdate: NoAction, map: "fk_users_cities")
  dish_comments dish_comments[]
  favorites     favorites[]
  orders        orders[]
  bonus_cards   bonus_cards[]
}

model bonus_cards {
  uuid         String   @id @default(uuid()) @db.Uuid
  user_uuid    String   @db.Uuid
  name         String   @db.VarChar(128)
  amount       Int
  description  String   @db.VarChar(512)
  active_until DateTime @db.Timestamptz(6)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users    @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, map: "fk_bonus_cards_users")

  @@index([user_uuid], map: "idx_bonus_cards_user")
}
